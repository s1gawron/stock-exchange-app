# Copy to .env and fill in. Never commit .env.
# Read by docker compose and by the backend (spring.config.import).
FINNHUB_API_KEY=

# "finnhub" (default) or "fake" (offline: 8 symbols, market always open, no key needed)
# MARKET_DATA_PROVIDER=finnhub

# Optional overrides (defaults shown)
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=stocksim
# DB_USER=stocksim
# DB_PASSWORD=stocksim
# REDIS_HOST=localhost
# REDIS_PORT=6380
